# Copia este archivo a .env (que NO se sube al repositorio) y llena lo que quieras activar.
# Sin TESITURA_SMTP_HOST los correos quedan en modo consola: se guardan en backend/correos_enviados/.
#
# Ejemplo con Gmail: crea una "contraseña de aplicación" (no uses tu contraseña normal).
# TESITURA_SMTP_HOST=smtp.gmail.com
# TESITURA_SMTP_PORT=587
# TESITURA_SMTP_USER=tucorreo@gmail.com
# TESITURA_SMTP_PASSWORD=contraseña-de-aplicacion
# TESITURA_SMTP_FROM=Tesitura <tucorreo@gmail.com>
#
# Token para ver las métricas del asistente y sus documentos internos (invéntalo largo):
# TESITURA_ADMIN_TOKEN=cambia-esto-por-algo-largo
# Variante del recomendador: arbol (por defecto), bosque o reglas
# RECOMENDADOR=arbol
